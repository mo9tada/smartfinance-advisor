# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=trading_pipeline
DB_USER=postgres
DB_PASSWORD=change-me

# Auth (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=change-me

# First administrator (backend/seed_admin.py)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_MATRICULE=SFA-0001
SEED_ADMIN_PASSWORD=change-me

# Email notifications (SMTP, e.g. a Gmail app password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=your-app-password

# Market data
TIINGO_API_KEY=your-tiingo-key

# LLM for the RAG assistant
GEMINI_API_KEY=your-gemini-key
